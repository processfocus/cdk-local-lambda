# Docker bridge image for x86_64 architecture
# This image contains the bridge handler for DockerImageFunction lambdas
FROM public.ecr.aws/lambda/nodejs:24-x86_64

# Copy the runtime wrapper (implements Lambda Runtime API and calls bridge handler)
COPY runtime.js /var/task/runtime.js
COPY bootstrap.sh /var/runtime/bootstrap

# Make bootstrap executable
RUN chmod +x /var/runtime/bootstrap

# Set the handler - Lambda will call this
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

ENTRYPOINT ["/var/runtime/bootstrap"]
CMD ["index.handler"]
